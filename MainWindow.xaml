<Window x:Class="KoaZa.Foreseer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KoaZa Foreseer | کوازا آینده‌نگر" Height="900" Width="1480" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBg}" FlowDirection="RightToLeft">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="کوازا آینده‌نگر" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="KoaZa Foreseer  ·  تحلیل و احتمال فوتبال" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
      </StackPanel>
      <Border Grid.Column="1" Background="#12382F" BorderBrush="#226C56" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
          <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="نسخهٔ 0.2.0 · تحلیل آماری از منابع متصل" Foreground="#A6F4D8" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="12" Padding="14" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="اتصال منبع اصلی" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="کلید API-Football (اختیاری؛ برای فهرست وسیع‌تر و مسابقات زنده)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6" />
          <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" MaxWidth="720" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
          <Button Content="ذخیرهٔ تنظیمات" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" />
          <Button Content="تازه‌سازی داده‌ها" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="12" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="رقابت‌های من" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="رقابت‌های قابل کشف از منابع متصل" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="جست‌وجوی لیگ یا کشور" Margin="0,0,0,8" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="انتخاب همه" Command="{Binding SelectAllCommand}" Padding="9,6" Margin="0,0,6,0" />
            <Button Content="پاک‌کردن انتخاب" Command="{Binding ClearSelectionCommand}" Padding="9,6" Background="#27374E" Foreground="White" />
          </StackPanel>
          <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredCompetitions}" IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single" CanUserSortColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48" />
              <DataGridTextColumn Header="رقابت" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="منبع" Binding="{Binding Provider}" Width="86" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="4" Text="{Binding SelectedCount, StringFormat='رقابت فعال: {0}'}" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="240"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" CornerRadius="12" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="المباريات" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="مباشر وموعدها خلال ۷ روز آینده · انتخاب مسابقه برای دیدن تحلیل" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <Border Background="#17382F" CornerRadius="7" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding LiveCount, StringFormat='LIVE {0}'}" Foreground="#8DF0C8" FontWeight="SemiBold" /></Border>
                <Border Background="#1B2A40" CornerRadius="7" Padding="10,5"><TextBlock Text="{Binding UpcomingCount, StringFormat='NEXT {0}'}" Foreground="#B9CBE2" /></Border>
              </StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture, Mode=TwoWay}" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="وضعیت / زمان" Binding="{Binding StateLabel}" Width="120" />
                <DataGridTextColumn Header="رقابت" Binding="{Binding Competition}" Width="155" />
                <DataGridTextColumn Header="میزبان" Binding="{Binding HomeTeam}" Width="*" />
                <DataGridTextColumn Header="نتیجه" Binding="{Binding Score}" Width="78" />
                <DataGridTextColumn Header="میهمان" Binding="{Binding AwayTeam}" Width="*" />
                <DataGridTextColumn Header="کشور" Binding="{Binding Country}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="12" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock Text="تحلیل احتمال بازارها" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="مدل پایهٔ پواسون با تاریخچهٔ محلی؛ در صورت ناکافی بودن داده، احتمال ساخته نمی‌شود." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Predictions}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="بازار" Binding="{Binding Market}" Width="150" />
                <DataGridTextColumn Header="خروجی" Binding="{Binding Outcome}" Width="190" />
                <DataGridTextColumn Header="احتمال" Binding="{Binding Probability}" Width="100" />
                <DataGridTextColumn Header="کیفیت داده" Binding="{Binding Confidence}" Width="120" />
                <DataGridTextColumn Header="توضیح" Binding="{Binding Note}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#0F1B2B" CornerRadius="8" Padding="10" Margin="0,14,0,0">
      <DockPanel>
        <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Right" Text="دادهٔ آماری، نه توصیهٔ شرط‌بندی" Foreground="#8193AA" FontSize="11" Margin="14,0,0,0" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
