<Application x:Class="KoaZa.Foreseer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#0B1220" />
    <SolidColorBrush x:Key="PanelBg" Color="#111C2E" />
    <SolidColorBrush x:Key="PanelAlt" Color="#17243A" />
    <SolidColorBrush x:Key="Accent" Color="#35D0A0" />
    <SolidColorBrush x:Key="TextMain" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextMuted" Color="#91A2B8" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#07131C" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Background" Value="#0B1423" />
      <Setter Property="BorderBrush" Value="#30415B" />
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource PanelBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="RowBackground" Value="{StaticResource PanelBg}" />
      <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAlt}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#26354A" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </Application.Resources>
</Application>
